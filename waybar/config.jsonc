
{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,

  "modules-left": [
    "group/date",
    "group/spotify"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "group/performance",
    "group/connectivity"
  ],

  // ─────────────────────────────────────
  // DATE ISLAND
  // ─────────────────────────────────────

  "group/date": {
    "orientation": "horizontal",

    "class": "group-date",

    "modules": [
      "custom/notification",
      "clock"
    ]
  },

  "custom/notification": {
    "format": "",

    "tooltip": false,

    "on-click": "swaync-client -t -sw",

    "escape": true
  },

  "clock": {
    "format": "󰃭  {:%a, %b %d  %I:%M %p}",

    "interval": 1,

    "tooltip-format": "<tt>{calendar}</tt>",

    "calendar": {
      "format": {
        "today": "<span color='#fAfBfC'><b>{}</b></span>"
      }
    },

    "actions": {
      "on-click": "shift_up",

      "on-click-right": "shift_down"
    }
  },

  // ─────────────────────────────────────
  // SPOTIFY ISLAND
  // ─────────────────────────────────────

  "group/spotify": {
    "orientation": "horizontal",

    "class": "group-spotify",

    "drawer": {
      "transition-duration": 0,

      "click-to-reveal": true
    },

    "modules": [
      "custom/expand-right",
      "custom/spotify-prev",
      "custom/spotify-play",
      "custom/spotify-next",
      "custom/spotify"
    ]
  },

  "custom/expand-right": {
    "format": "󰝚",

    "tooltip": false
  },

  "custom/spotify": {
    "exec": "~/.config/waybar/scripts/spotify.sh",

    "interval": 2,

    "tooltip": true,

    "on-click": "~/.config/waybar/scripts/spotify-toggle.sh",

    "on-scroll-up": "playerctl -p spotify volume 0.05+",

    "on-scroll-down": "playerctl -p spotify volume 0.05-"
  },

  "custom/spotify-prev": {
    "format": "󰒮",

    "tooltip": false,

    "on-click": "playerctl -p spotify previous"
  },

  "custom/spotify-play": {
    "exec": "playerctl -p spotify status | grep -q Playing && echo '󰏤' || echo '󰐊'",

    "interval": 2,

    "on-click": "playerctl -p spotify play-pause",

    "tooltip": false
  },

  "custom/spotify-next": {
    "format": "󰒭",

    "tooltip": false,

    "on-click": "playerctl -p spotify next"
  },

  // ─────────────────────────────────────
  // WORKSPACES ISLAND
  // ─────────────────────────────────────

  "hyprland/workspaces": {
    "format": "{icon}",

    "format-icons": {
      "active": "󰮯",

      "default": "󰊠",

      "empty": "󰧞"
    },

    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },

  // ─────────────────────────────────────
  // PERFORMANCE ISLAND
  // ─────────────────────────────────────

  "group/performance": {
    "orientation": "horizontal",

    "class": "group-performance",

    "drawer": {
      "transition-duration": 0,

      "click-to-reveal": true
    },

    "modules": [
      "custom/expand",
      "custom/powerprofile",
      "cpu",
      "memory",
      "temperature"
    ]
  },

  "custom/expand": {
    "format": "󰍜",

    "tooltip": false
  },

  "custom/powerprofile": {
    "exec": "sh -c 'case $(powerprofilesctl get) in performance) echo 󰓅 ;; balanced) echo 󰾅 ;; power-saver) echo 󰾆 ;; esac'",

    "interval": 5,

    "format": "{}",

    "on-click": "~/.config/scripts/power-cycle.sh"
  },

  "cpu": {
    "format": "󰍛  {usage}%"
  },

  "memory": {
    "format": "󰘚  {percentage}%"
  },

  "temperature": {
    "critical-threshold": 90,

    "format": "󰔏  {temperatureC}°C"
  },

  // ─────────────────────────────────────
  // CONNECTIVITY ISLAND
  // ─────────────────────────────────────

  "group/connectivity": {
    "orientation": "horizontal",

    "class": "group-connectivity",

    "modules": [
      "custom/pacman",
      "bluetooth",
      "network",
      "battery"
    ]
  },

  "custom/pacman": {
    "format": "󰏗  {}",

    "interval": 1800,

    "exec": "checkupdates | wc -l",

    "on-click": "kitty sh -c 'yay -Syu; echo Done — press enter to close; read'"
  },

  "bluetooth": {
    "format-on": "󰂯",

    "format-off": "󰂲",

    "format-disabled": "󰂲",

    "format-connected": "󰂱",

    "format-connected-battery": "󰂱",

    "tooltip": true,

    "tooltip-format": "{controller_alias}\nStatus: {status}",

    "tooltip-format-connected": "{controller_alias}\nConnected: {num_connections}",

    "tooltip-format-connected-battery": "{controller_alias}\nConnected: {num_connections}",

    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "{icon}",

    "format-ethernet": "󰈀",

    "format-disconnected": "󰤮",

    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],

    "tooltip-format-wifi": "  {essid}\n󰤨  Strength: {signalStrength}%\n󰈀  {ipaddr}",

    "tooltip-format-ethernet": "󰈀  {ifname}\n{ipaddr}",

    "tooltip-format-disconnected": "󰤮  No connection",

    "on-click": "kitty nmtui",

    "interval": 3
  },

  "battery": {
    "interval": 30,

    "states": {
      "good": 80,

      "warning": 35,

      "critical": 20
    },

    "format": "{icon}  {capacity}%",

    "format-alt": "{icon}  {time}",

    "format-charging": "{icon}  {capacity}%",

    "format-full": "󰁹  100%",

    "format-icons": {
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],

      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ]
    }
  }
}

